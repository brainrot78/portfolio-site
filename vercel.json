{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/post",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/#projects",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/medaminehammami",
      "permanent": false
    },
    {
      "source": "/linkedin",
      "destination": "https://www.linkedin.com/in/medamine-hammami",
      "permanent": false
    },
    {
      "source": "/feed",
      "destination": "/threats",
      "permanent": false
    },
    {
      "source": "/cves",
      "destination": "/threats",
      "permanent": false
    },
    {
      "source": "/navigator",
      "destination": "/attack",
      "permanent": false
    },
    {
      "source": "/mitre",
      "destination": "/attack",
      "permanent": false
    },
    {
      "source": "/ioc",
      "destination": "/toolbox",
      "permanent": false
    },
    {
      "source": "/simulator",
      "destination": "/projects/banking-security-platform#sim",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug([a-z0-9-]+)",
      "destination": "/blog/post.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/attack/layer.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}